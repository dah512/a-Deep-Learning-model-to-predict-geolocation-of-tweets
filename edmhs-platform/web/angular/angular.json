{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "gpcs-r": {
      "projectType": "application",
      "root": "", "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/gpcs-r", "index": "src/index.html", "browser": "src/main.ts",
            "polyfills": ["zone.js"], "tsConfig": "tsconfig.json", "styles": ["src/styles.css"]
          }
        },
        "serve": { "builder": "@angular/build:dev-server", "options": { "buildTarget": "gpcs-r:build" } }
      }
    }
  },
  "cli": { "analytics": false }
}
